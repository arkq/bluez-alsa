# SPDX-License-Identifier: MIT

# General options
input_tab_size                  = 2
output_tab_size                 = 2
string_replace_tab_chars        = true

# Spacing
sp_arith                        = force
sp_assign                       = force
sp_bool                         = force
sp_compare                      = force
sp_inside_paren                 = remove
sp_paren_paren                  = remove
sp_paren_brace                  = force
sp_before_ptr_star              = force
sp_between_ptr_star             = remove
sp_after_ptr_star               = force
sp_after_ptr_star_qualifier     = force
sp_after_ptr_star_func          = force
sp_before_sparen                = force
sp_inside_sparen                = remove
sp_after_sparen                 = force
sp_sparen_brace                 = force
sp_before_semi_for              = remove
sp_before_semi_for_empty        = remove
sp_between_semi_for_empty       = remove
sp_after_semi_for_empty         = remove
sp_before_square                = remove
sp_inside_square                = remove
sp_after_comma                  = force
sp_after_cast                   = remove
sp_inside_paren_cast            = remove
sp_sizeof_paren                 = remove
sp_inside_braces                = force
sp_func_proto_paren             = remove
sp_func_def_paren               = remove
sp_inside_fparens               = remove
sp_inside_fparen                = remove
sp_fparen_brace                 = force
sp_func_call_paren              = remove
sp_return_paren                 = force
sp_attribute_paren              = force
sp_defined_paren                = remove
sp_else_brace                   = force
sp_brace_else                   = force
sp_brace_typedef                = force
sp_cond_colon                   = force
sp_cond_question                = force
sp_cmt_cpp_start                = force
# Do not force here to allow multi-line alignment
sp_before_tr_cmt                = add
sp_num_before_tr_cmt            = 1

# Indenting
indent_columns                  = 2
# Indent with tabs, align with spaces
indent_with_tabs                = 1
indent_func_call_param          = false
indent_func_def_param           = true
indent_func_proto_param         = true
indent_func_param_double        = true
indent_case_comment             = false

# Newline adding and removing
nl_collapse_empty_body          = true
nl_assign_leave_one_liners      = true
nl_enum_leave_one_liners        = true
nl_func_leave_one_liners        = true
nl_start_of_file                = remove
nl_end_of_file                  = force
nl_end_of_file_min              = 1
nl_assign_brace                 = remove
nl_fcall_brace                  = remove
nl_enum_brace                   = remove
nl_struct_brace                 = remove
nl_union_brace                  = remove
nl_if_brace                     = remove
nl_brace_else                   = force
nl_else_brace                   = remove
nl_else_if                      = remove
nl_for_brace                    = remove
nl_while_brace                  = remove
nl_do_brace                     = remove
nl_brace_while                  = remove
nl_switch_brace                 = remove
nl_func_paren                   = remove
nl_func_def_paren               = remove
nl_func_call_paren              = remove
nl_func_decl_empty              = remove
nl_func_def_empty               = remove
nl_func_call_empty              = remove
nl_fdef_brace                   = remove
nl_split_if_one_liner           = true
nl_split_for_one_liner          = true
nl_split_while_one_liner        = true

# Line splitting
code_width                      = 99

# Code alignment
align_keep_tabs                 = false
align_with_tabs                 = false

# Comment modifications
cmt_width                       = 99
cmt_star_cont                   = true
cmt_multi_check_last            = false

# Code modifications
mod_paren_on_return             = remove
mod_remove_extra_semicolon      = true
mod_remove_duplicate_include    = true
mod_sort_include                = true
mod_sort_incl_import_ignore_extension = true
mod_case_brace                  = remove
mod_remove_empty_return         = true
mod_enum_last_comma             = force
mod_infinite_loop               = 1

# Preprocessor options
pp_indent                       = remove
pp_space_after                  = force
pp_space_count                  = 1
pp_multiline_define_body_indent = 2
